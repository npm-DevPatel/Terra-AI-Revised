# Terra AI — Environment Variables Template
# Copy this file to .env and fill in your API keys
# For Vercel: add each VITE_* var via Vercel Dashboard → Settings → Environment Variables

# ── Frontend (exposed to browser via Vite) ──────────────────────────────────
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Supabase (frontend) ───────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# ── Backend URL (optional, for local overrides) ───────────────────────────────
# In production Vercel rewrites /api/* → Render automatically via vercel.json
# Only set this if you need to hit the backend directly from the frontend
# VITE_API_BASE_URL=https://your-render-service.onrender.com

# ── Backend (Flask) ───────────────────────────────────────────────────────────
LLAMA_API_KEY=llx_your_llama_api_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
