# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment variables — never commit real keys
.env
.env.local
backend/.env

# Python
venv/
backend/venv/
**/__pycache__/
*.pyc
*.pyo

# Always include .env.example files (they have placeholder values, not real keys)
!.env.example
!backend/.env.example

# ML model weights — tracked via Git LFS (see .gitattributes)
# backend/yolov8n-seg.pt   ← DO NOT add here; LFS handles it

# Ignore docs
docs/

# Datasets — large shapefiles tracked via Git LFS (see .gitattributes)
# HydroRIVERS (~420 MB) and Kenya_HG (~700 KB) are LFS-tracked
# datasets/                ← DO NOT add here; LFS handles it
