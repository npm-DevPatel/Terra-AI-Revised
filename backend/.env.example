# Terra AI Backend — Environment Variables
# Set ALL of these in Render: Dashboard → Service → Environment → Add Env Var

# ── Google APIs ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_EARTH_ENGINE_API_KEY=your_gee_api_key_here

# ── Supabase (server-side) ────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ── Server ────────────────────────────────────────────────────────────────────
# Render sets PORT automatically — do NOT set this manually in Render
# PORT=5000

# ── CORS — set this to your Vercel frontend URL, with no trailing slash ───────
FRONTEND_URL=https://your-app.vercel.app
